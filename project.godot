; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

_config_version=5

[application]

config/name="安顺麻将·捉鸡"
config/name_localized={
"en": "Anshun Mahjong"
}
config/version="1.6.0"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://res/icons/game_icon.png"

[audio]

driver/enable_input=true
driver/mix_rate=48000

[autoload]

PatchBoot="*res://scripts/autoload/PatchBoot.gd"
GameConfig="*res://scripts/autoload/GameConfig.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
Network="*res://scripts/autoload/Network.gd"
UpdateManager="*res://scripts/autoload/UpdateManager.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"

[display]

window/size/viewport_width=2280
window/size/viewport_height=1280
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_toolkit/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[network]

gme_auth_url="https://mj.dongxiu.fun/gme-auth"

[online]

default_url="https://mj.dongxiu.fun"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[updates]

base_id="1.4.13-boot1"
tag_prefix="V"
manifest_asset="update-manifest.json"
github_repository="dongxiujiang/anshun-mahjong"
manifest_url=""
manifest_public_key=""
manifest_urls=["https://mj.dongxiu.fun/updates/update-manifest.json", "https://mj.dongxiu.fun/updates/update-manifest-fallback.json"]
auto_check=true
windows_asset="anshun-mahjong-windows-x64.exe"
android_asset="anshun-mahjong.apk"







