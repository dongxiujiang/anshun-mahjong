# Mode 2: prebuilt image from CI, e.g.
# ghcr.io/<owner>/<repo>:V1.0.4
# Leave empty for source-build deploy.sh.
APP_IMAGE=

# Public HTTPS hostname for the room directory and Caddy certificate.
DOMAIN=play.example.com

# Address returned to clients for the UDP room connection.
# Normally the same hostname as DOMAIN. If the Godot ENet client cannot
# resolve the hostname on your server, use the public IPv4 address here.
PUBLIC_HOST=play.example.com

# Number of simultaneous Godot room processes.
# Keep FIRST_PORT + MAX_ROOMS <= 7632 with the compose.yaml UDP range.
MAX_ROOMS=16
FIRST_PORT=7600

# Self-hosted LiveKit voice. The token endpoint signs short-lived room tokens
# with the same API key/secret that the LiveKit server receives in LIVEKIT_KEYS.
LIVEKIT_URL=wss://mj.dongxiu.fun/livekit
LIVEKIT_API_KEY=APIchange_me
LIVEKIT_API_SECRET=change_me_to_a_long_random_secret
LIVEKIT_KEYS=APIchange_me: change_me_to_a_long_random_secret
LIVEKIT_TOKEN_TTL=3600
