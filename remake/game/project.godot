; 东秀麻将重制工作工程，正式安装升级仍沿现有应用。
config_version=5

[application]
config/version="2.4.2"
config/name="东秀麻将"
config/icon="res://src/app/assets/android_icon.png"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
PatchBoot="*res://src/app/PatchBoot.gd"

[updates]
base_id="2.4.2-r1"
version_code=9
auto_check=true
manifest_path="/v1/updates/manifest"

[dongxiu]
online_directory_url="https://mj.dongxiu.fun"

[audio]
driver/enable_input=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
lights_and_shadows/directional_shadow/size.mobile=1024
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
