# ── Godot 4 ──────────────────────────────────────────────
# 编辑器导入缓存与本地设置，随时可重建
.godot/
# 部分工具把 APPDATA 重定向到工程内；此目录含本机设置和 MCP 会话令牌。
/Godot/
# 即使令牌路径被配置到其他目录，也不能入库。
mcp_token
# 导出时写入的签名凭据（keystore 路径/口令），绝不能提交
.godot/export_credentials.cfg
export_credentials.cfg

# ── 构建产物与本地工具链 ─────────────────────────────────
# build/ 里是导出产物、测试日志，以及完整的 Android SDK + JDK（约数 GB），
# 体积大且平台相关，全部不入库。需要时按 README 第五节重新导出。
build/

# Android 构建模板由 Godot 在构建时重新生成，既有约 1 GB 的 Gradle 缓存/产物，
# 也有本机版本标记；不跟踪模板目录，避免 git add . 误收生成文件。
/android/

# ── 本地环境 / 编辑器 ────────────────────────────────────
# Docker 部署配置（域名等），每台服务器单独填写，不入库。
.env
.mcp.json
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ── 测试与运行日志 ───────────────────────────────────────
*.log
*.out
*.err
__pycache__/
*.pyc
# 自动生成的牌型测试输出和截图（测试脚本、规则验证报告仍保留）。
/test_results/
/test_screenshots/
# 临时源码备份，不作为正式实现发布。
*.bak

# ── Android 签名文件 ─────────────────────────────────────
*.keystore
*.jks
